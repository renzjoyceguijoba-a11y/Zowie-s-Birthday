<style>
@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Pacifico&display=swap');

:root {
  --pink:#ffd9e9;
  --pink2:#ffb9d5;
  --purple:#e6d9ff;
  --blue:#d9efff;
  --yellow:#fff0bb;
  --ink:#795b80;
  --white:#fffdfd;
}
* { box-sizing:border-box; }
html { scroll-behavior:smooth; scroll-snap-type:y proximity; }
body {
  margin:0; color:var(--ink);
  font-family:'Nunito',sans-serif;
  background:#fff8fc;
}
button,input,textarea,select { font:inherit; }
button { cursor:pointer; }
button:focus-visible,input:focus-visible,textarea:focus-visible {
  outline:3px solid #b69aff; outline-offset:2px;
}
#toolbar {
  position:sticky; top:0; z-index:1000;
  background:rgba(255,250,254,.96);
  backdrop-filter:blur(12px);
  padding:10px 14px; border-bottom:1px solid #f2d9e9;
  box-shadow:0 3px 18px #cba7c520;
}
.brand { font-weight:800; color:#bc78a4; }
.toolbar-top {
  display:flex; justify-content:space-between; align-items:center;
  gap:10px; flex-wrap:wrap;
}
.tools {
  display:flex; gap:7px; flex-wrap:wrap; margin-top:10px;
}
.btn {
  border:1px solid #ead5f0; background:white; color:#795b80;
  border-radius:13px; padding:8px 12px; font-weight:800;
  font-size:12px; transition:.2s;
}
.btn:hover { transform:translateY(-1px); background:#fff0f8; }
.btn.primary { background:#f5d8ff; }
.btn.danger { color:#b45075; }
.btn.active { background:#e4d9ff; }
.small { font-size:11px; opacity:.8; }
#editor {
  display:grid; grid-template-columns:minmax(0,1fr) 280px;
  gap:14px; max-width:1500px; margin:auto; padding:16px;
}
#pages { min-width:0; }
.page {
  position:relative; isolation:isolate; overflow:hidden;
  min-height:700px; margin:0 auto 22px;
  max-width:1000px; width:100%;
  border:5px solid white; border-radius:25px;
  box-shadow:0 10px 40px #ba8dbb26;
  background:
    radial-gradient(ellipse at 15% 10%,#fff 0%,transparent 28%),
    radial-gradient(ellipse at 90% 90%,#ffe0ee 0%,transparent 35%),
    linear-gradient(145deg,#fff1f8,#f3eaff 55%,#e9f7ff);
  scroll-snap-align:start;
}
.page::before {
  content:""; position:absolute; inset:12px;
  border:1px dashed #e6acd1; border-radius:17px;
  pointer-events:none; z-index:-1;
}
.page-head {
  text-align:center; padding:36px 22px 10px;
}
.eyebrow {
  text-transform:uppercase; letter-spacing:3px; font-size:11px;
  font-weight:800; color:#b77ab0;
}
h1,h2 { font-family:'Pacifico',cursive; font-weight:400; }
.page h2 { font-size:clamp(26px,5vw,43px); margin:8px 0; }
.page p { line-height:1.7; }
.cover-content {
  text-align:center; max-width:700px; margin:0 auto;
  padding:65px 24px 60px; position:relative;
}
.cover-content h1 {
  font-size:clamp(43px,8vw,76px); line-height:1.25;
  color:#d77fb0; margin:14px 0;
  overflow-wrap:anywhere;
  text-shadow:2px 3px white,4px 5px #eac4f3;
}
.subtitle { font-size:clamp(14px,2.3vw,20px); }
.info-card {
  margin:25px auto; max-width:420px; padding:22px;
  border:2px solid white; border-radius:25px;
  background:#ffffffa6; box-shadow:0 6px 20px #c69bc526;
}
.info-line { margin:10px 0; font-weight:800; overflow-wrap:anywhere; }
.magic-button {
  display:inline-block; padding:13px 26px; margin-top:5px;
  color:#805d8e; background:linear-gradient(100deg,#ffd9ea,#e4dcff,#d7f1ff);
  border:2px solid white; border-radius:30px;
  font-weight:800; text-decoration:none;
}
.page-decor { position:absolute; inset:0; pointer-events:none; z-index:0; }
.page-decor .floating { position:absolute; animation:float 4s ease-in-out infinite; }
@keyframes float { 50% { transform:translateY(-9px) rotate(4deg); } }
.page-content { position:relative; z-index:1; }
.gallery {
  display:grid; grid-template-columns:repeat(4,minmax(0,1fr));
  gap:13px; padding:25px clamp(16px,4vw,48px) 55px;
}
.gallery.three { grid-template-columns:repeat(3,minmax(0,1fr)); }
.gallery.single { grid-template-columns:minmax(0,360px); justify-content:center; }
.frame {
  position:relative; min-width:0; min-height:270px;
  aspect-ratio:3/4; border:3px solid white; border-radius:15px;
  background:#ffffff65; box-shadow:0 6px 18px #b48ac21b;
  overflow:hidden; cursor:grab; touch-action:pan-y;
}
.frame::after {
  content:""; position:absolute; inset:5px;
  border:1px dashed #e6bbda; border-radius:9px;
  pointer-events:none;
}
.frame img { width:100%; height:100%; object-fit:cover; display:block; }
.frame .empty-label {
  position:absolute; inset:0; display:flex; align-items:center;
  justify-content:center; flex-direction:column; gap:8px;
  color:#bb91b9; text-align:center; font-size:12px;
}
.frame.selected,.sticker.selected,.text-item.selected {
  outline:3px solid #ad88ff; outline-offset:3px;
}
.frame.selected::before {
  content:"SELECTED"; position:absolute; z-index:5; top:10px; left:10px;
  background:#fff; padding:3px 6px; border-radius:8px;
  font-size:9px; font-weight:800;
}
.sticker {
  position:absolute; z-index:4; left:10%; top:10%;
  font-size:48px; line-height:1; cursor:grab;
  user-select:none; touch-action:none;
  filter:drop-shadow(0 3px 3px #b993b533);
}
.sticker img { width:100%; height:100%; object-fit:contain; pointer-events:none; }
.text-item {
  position:absolute; z-index:5; left:10%; top:12%;
  min-width:30px; max-width:80%; padding:5px;
  white-space:pre-wrap; overflow-wrap:anywhere;
  cursor:grab; touch-action:none; user-select:text;
}
.text-item[contenteditable="true"] { cursor:text; }
.text-item.selected { background:#ffffff40; }
.frame.selected,.sticker.selected { z-index:20; }
.frame.selected { outline-offset:-4px; }
.thankyou {
  text-align:center; padding:100px 25px 90px;
}
.thankyou h2 { color:#d77fb0; font-size:clamp(34px,7vw,60px); }
#panel {
  align-self:start; position:sticky; top:125px;
  max-height:calc(100vh - 145px); overflow:auto;
  padding:17px; border:1px solid #f0d9ed; border-radius:20px;
  background:#fffafd; box-shadow:0 6px 24px #c7a5c31a;
}
#panel h3 { margin:0 0 8px; color:#b66da0; }
#panel label { display:block; margin-top:12px; font-size:12px; font-weight:800; }
#panel input:not([type=color]):not([type=file]),
#panel textarea,#panel select {
  width:100%; padding:9px; border:1px solid #ead5e9;
  border-radius:10px; background:white; color:var(--ink);
  margin-top:5px;
}
#panel input[type=color] { width:100%; height:38px; margin-top:5px; }
#panel input[type=range] { width:100%; }
#panel input[type=file] { width:100%; margin-top:7px; font-size:11px; }
#panel textarea { min-height:80px; resize:vertical; }
.panel-actions { display:flex; flex-wrap:wrap; gap:6px; margin-top:12px; }
.rule { border:0; border-top:1px solid #f0ddea; margin:17px 0; }
#toast {
  position:fixed; bottom:20px; left:50%; transform:translateX(-50%);
  z-index:2000; background:#765b80; color:white; padding:10px 17px;
  border-radius:30px; box-shadow:0 5px 25px #0002;
  opacity:0; pointer-events:none; transition:opacity .2s;
}
#toast.show { opacity:1; }
#fileInput { display:none; }
.preview #toolbar,.preview #panel,.preview .editor-only { display:none!important; }
.preview #editor { display:block; padding:0; max-width:none; }
.preview .page { border-radius:0; border:0; box-shadow:none; max-width:none; margin:0; min-height:100vh; }
.preview .page::before { border-radius:0; }
.preview .page-head { padding-top:50px; }
.preview .page:not(:first-child) { page-break-before:always; }
@media(max-width:850px) {
  #editor { grid-template-columns:1fr; padding:9px; }
  #panel { position:relative; top:0; max-height:none; grid-row:1; }
  .page { min-height:620px; }
  .gallery { gap:7px; padding:22px 18px 45px; }
  .frame { min-height:155px; border-width:2px; }
  .sticker { font-size:35px; }
}
@media(max-width:430px) {
  .gallery { gap:5px; padding-left:14px; padding-right:14px; }
  .frame { min-height:115px; border-radius:10px; }
  .frame::after { inset:3px; }
  .cover-content { padding-top:50px; }
  .page { min-height:570px; }
