@media print {
  #toolbar,#panel,.editor-only { display:none!important; }
  #editor { display:block; padding:0; }
  .page { border:0; box-shadow:none; border-radius:0; max-width:none; margin:0; min-height:100vh; page-break-after:always; }
  body { background:white; }
