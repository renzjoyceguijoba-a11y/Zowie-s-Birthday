<script>
const $ = id => document.getElementById(id);
let selected = null;
let currentPage = 1;
let nextId = 1;
let historyStack = [];
let redoStack = [];
let previewMode = false;
let drag = null;
let toastTimer;

const pageElements = {
  1: [],
  2: [],
  3: [],
  4: [],
  5: []
};

function uid() { return 'el' + nextId++; }
function currentPageEl() { return $('page' + currentPage); }

function toast(message) {
  const t = $('toast');
  t.textContent = message;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
}

function snapshot() {
  try {
    historyStack.push(JSON.stringify(serialize()));
    if (historyStack.length > 30) historyStack.shift();
    redoStack = [];
  } catch (e) {}
}

function serialize() {
  const pages = {};
  for (let n=1;n<=5;n++) {
    const p = $('page'+n);
    pages[n] = {
      background: p.style.background || '',
      elements: pageElements[n].map(el => ({
        ...el,
        style: {...el.style}
      }))
    };
  }
  return {
    version:1, nextId, details:{
      name:$('nameInput').value,
      date:$('dateInput').value,
      venue:$('venueInput').value,
      heading:$('headingInput').value,
      thanks:$('thanksInput').value
    }, pages
  };
}

function restore(data) {
  if (!data || !data.pages) throw new Error('Invalid project');
  nextId = data.nextId || 1;
  Object.values(pageElements).forEach(arr => arr.splice(0,arr.length));
  for (let n=1;n<=5;n++) {
    const p = $('page'+n);
    p.querySelectorAll('.text-item,.frame,.sticker').forEach(el => el.remove());
    const pg = data.pages[n];
    if (!pg) continue;
    p.style.background = pg.background || '';
    pageElements[n] = (pg.elements || []).map(el => ({...el,style:{...(el.style||{})}}));
    pageElements[n].forEach(el => renderElement(n,el));
  }
  const d = data.details || {};
  $('nameInput').value = d.name || '';
  $('dateInput').value = d.date || '';
  $('venueInput').value = d.venue || '';
  $('headingInput').value = d.heading || '';
  $('thanksInput').value = d.thanks || '';
  applyDetails(false);
  selectElement(null);
}

function saveProject() {
  try {
    localStorage.setItem('magicalBirthdayProject', JSON.stringify(serialize()));
    toast('Your invitation is saved in this browser! 💗');
  } catch (e) {
    toast('Storage is full. Export a backup or use smaller photos.');
  }
}

function loadProject() {
  try {
    const saved = localStorage.getItem('magicalBirthdayProject');
    if (saved) restore(JSON.parse(saved));
  } catch (e) {
    toast('Saved project could not be loaded.');
  }
}

function exportJSON() {
  const blob = new Blob([JSON.stringify(serialize(),null,2)],{type:'application/json'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'my-magical-birthday-backup.json';
  a.click();
  URL.revokeObjectURL(a.href);
  toast('Backup exported! Keep it somewhere safe.');
}

$('importInput').addEventListener('change', async e => {
  const file = e.target.files[0];
  if (!file) return;
  try {
    restore(JSON.parse(await file.text()));
    saveProject();
    toast('Backup imported successfully! 🎀');
  } catch(err) { toast('That backup file could not be opened.'); }
  e.target.value = '';
});

function undo() {
  if (!historyStack.length) return toast('Nothing to undo yet.');
  redoStack.push(JSON.stringify(serialize()));
  restore(JSON.parse(historyStack.pop()));
  toast('Undo complete.');
}
function redo() {
  if (!redoStack.length) return toast('Nothing to redo yet.');
  historyStack.push(JSON.stringify(serialize()));
  restore(JSON.parse(redoStack.pop()));
  toast('Redo complete.');
}

function addElement(page, type, props={}) {
  snapshot();
  const el = {
    id:uid(), type,
    x:props.x ?? 10, y:props.y ?? 10,
    w:props.w ?? 80, h:props.h ?? 300,
    content:props.content || '',
    src:props.src || '',
    emoji:props.emoji || '🎀',
    style:props.style || {}
  };
  pageElements[page].push(el);
  renderElement(page,el);
  selectElement(el.id);
  return el;
}

function addText() {
  addElement(currentPage,'text',{
    x:12,y:20,w:65,content:'Write your message here ✨',
    style:{fontSize:28,color:'#d77fb0',fontFamily:'Nunito',textAlign:'center'}
  });
  toast('New text added! Edit it in the panel.');
}

function addSticker() {
  addElement(currentPage,'sticker',{
    x:12,y:18,w:60,h:60,emoji:'🎀'
  });
  toast('Sticker added! Choose a decoration in the panel.');
}

function addFrame() {
  addElement(currentPage,'frame',{
    x:10,y:20,w:80,h:280,
    style:{background:'#fff8fc',borderColor:'#ffffff',borderRadius:15,objectFit:'cover'}
  });
  toast('Photo frame added!');
}

function renderElement(page, data) {
  const p = $('page'+page);
  let el;
  if (data.type === 'text') {
    el = document.createElement('div');
    el.className = 'text-item';
    el.textContent = data.content;
    el.style.fontSize = (data.style.fontSize || 24) + 'px';
    el.style.color = data.style.color || '#d77fb0';
    el.style.fontFamily = data.style.fontFamily || 'Nunito';
    el.style.textAlign = data.style.textAlign || 'center';
    if (data.style.backgroundOn) el.style.background = data.style.background || '#ffffff';
    el.style.borderRadius = '10px';
    el.style.fontWeight = '800';
    el.style.minHeight = '24px';
  } else if (data.type === 'frame') {
    el = document.createElement('div');
    el.className = 'frame';
    el.style.background = data.style.background || '#fff8fc';
    el.style.borderColor = data.style.borderColor || '#ffffff';
    el.style.borderRadius = (data.style.borderRadius ?? 15) + 'px';
    if (data.src) {
      const img = document.createElement('img');
      img.src = data.src;
      img.alt = 'Birthday photo';
      img.style.objectFit = data.style.objectFit || 'cover';
      el.appendChild(img);
    } else {
      const empty = document.createElement('div');
      empty.className = 'empty-label';
      empty.innerHTML = '<span style="font-size:30px">♡</span><span>Photo goes here</span>';
      el.appendChild(empty);
    }
  } else if (data.type === 'sticker') {
    el = document.createElement('div');
    el.className = 'sticker';
    el.style.width = data.w + 'px';
    el.style.height = data.h + 'px';
    if (data.src) {
      const img = document.createElement('img');
      img.src = data.src;
      img.alt = 'Decorative sticker';
      el.appendChild(img);
    } else {
      el.textContent = data.emoji || '🎀';
      el.style.fontSize = Math.min(data.w,data.h) + 'px';
    }
  } else return;

  el.dataset.id = data.id;
  el.style.left = data.x + '%';
  el.style.top = data.y + '%';
  if (data.type !== 'sticker') {
    el.style.width = data.w + '%';
    if (data.type === 'frame') {
      el.style.height = data.h + 'px';
    } else {
      el.style.height = 'auto';
      el.style.minHeight = '25px';
    }
  }
  p.appendChild(el);
  attachElementEvents(el,page,data);
}

function attachElementEvents(node,page,data) {
  node.addEventListener('click', e => {
    e.stopPropagation();
    selectElement(data.id);
  });
  node.addEventListener('pointerdown', e => {
    if (e.target.isContentEditable) return;
    if (e.button !== 0) return;
    e.stopPropagation();
    selectElement(data.id);
    const rect = $('page'+page).getBoundingClientRect();
    drag = {
      id:data.id,page,
      startX:e.clientX,startY:e.clientY,
      oldX:data.x,oldY:data.y,
      pageW:rect.width,pageH:rect.height,
      moved:false
    };
    node.setPointerCapture?.(e.pointerId);
  });
  node.addEventListener('dblclick', () => {
    if (data.type==='text') {
      node.contentEditable='true';
      node.focus();
      toast('Edit the text directly, then click outside.');
    } else if (data.type==='frame') {
      $('frameUpload').click();
    }
  });
  if (data.type==='text') {
    node.addEventListener('input', () => { data.content = node.innerText; $('textContent').value = data.content; });
    node.addEventListener('blur', () => { node.contentEditable='false'; data.content=node.innerText; });
  }
}

document.addEventListener('pointermove', e => {
  if (!drag) return;
  const data = findElement(drag.id);
  if (!data) return;
  const dx = e.clientX-drag.startX, dy=e.clientY-drag.startY;
  if (Math.abs(dx)+Math.abs(dy)>3) drag.moved=true;
  if (!drag.moved) return;
  data.x = Math.max(0,Math.min(95,drag.oldX+dx/drag.pageW*100));
  data.y = Math.max(0,Math.min(95,drag.oldY+dy/drag.pageH*100));
  const node = document.querySelector(`[data-id="${data.id}"]`);
  if (node) { node.style.left=data.x+'%'; node.style.top=data.y+'%'; }
});
document.addEventListener('pointerup', () => {
  if (drag && drag.moved) snapshot();
  drag = null;
});

document.querySelectorAll('.page').forEach(p => {
  p.addEventListener('click', e => {
    if (e.target===p || e.target.classList.contains('page-decor') || e.target.classList.contains('page-content')) {
      currentPage=Number(p.dataset.page);
      selectElement(null);
    }
  });
});

function findElement(id) {
  for (let n=1;n<=5;n++) {
    const el=pageElements[n].find(e=>e.id===id);
    if (el) return el;
  }
  return null;
}

function findElementPage(id) {
  for (let n=1;n<=5;n++) if (pageElements[n].some(e=>e.id===id)) return n;
  return currentPage;
}

function selectElement(id) {
  selected=id;
  document.querySelectorAll('.selected').forEach(n=>n.classList.remove('selected'));
  if (!id) {
    $('selectionTools').hidden=true;
    $('noSelection').hidden=false;
    return;
  }
  const data=findElement(id);
  if (!data) return selectElement(null);
  currentPage=findElementPage(id);
  const node=document.querySelector(`[data-id="${id}"]`);
  if (node) node.classList.add('selected');
  $('selectionTools').hidden=false;
  $('noSelection').hidden=true;
  $('selectedDescription').textContent=data.type.toUpperCase()+' on Page '+currentPage;
  $('textTools').hidden=data.type!=='text';
  $('frameTools').hidden=data.type!=='frame';
  $('stickerTools').hidden=data.type!=='sticker';

  if(data.type==='text') {
    $('textContent').value=data.content;
    $('textFont').value=data.style.fontFamily||'Nunito';
    $('textSize').value=parseInt(data.style.fontSize)||24;
    $('textColor').value=data.style.color||'#d77fb0';
    $('textAlign').value=data.style.textAlign||'center';
    $('textBgOn').checked=!!data.style.backgroundOn;
    $('textBg').value=data.style.background||'#ffffff';
  } else if(data.type==='frame') {
    $('frameColor').value=data.style.background||'#fff8fc';
    $('frameRadius').value=data.style.borderRadius??15;
    $('frameBorder').value=data.style.borderColor||'#ffffff';
    $('photoFit').value=data.style.objectFit||'cover';
  } else if(data.type==='sticker') {
    $('stickerChoice').value=data.emoji||'🎀';
    $('stickerSize').value=data.w||55;
  }
}

function refreshSelected() {
  if (!selected) return;
  const data=findElement(selected), page=findElementPage(selected);
  if(!data) return;
  const old=document.querySelector(`[data-id="${selected}"]`);
  if(old) old.remove();
  renderElement(page,data);
  selectElement(data.id);
}

$('textContent').addEventListener('input',e=>{
  const d=findElement(selected); if(!d||d.type!=='text')return;
  d.content=e.target.value;
  const node=document.querySelector(`[data-id="${selected}"]`);
  if(node) node.textContent=d.content;
});
$('textFont').addEventListener('change',e=>updateStyle('fontFamily',e.target.value));
$('textSize').addEventListener('input',e=>updateStyle('fontSize',Number(e.target.value)));
$('textColor').addEventListener('input',e=>updateStyle('color',e.target.value));
$('textAlign').addEventListener('change',e=>updateStyle('textAlign',e.target.value));
$('textBg').addEventListener('input',e=>updateStyle('background',e.target.value));
$('textBgOn').addEventListener('change',e=>updateStyle('backgroundOn',e.target.checked));
$('frameColor').addEventListener('input',e=>updateStyle('background',e.target.value));
$('frameRadius').addEventListener('input',e=>updateStyle('borderRadius',Number(e.target.value)));
$('frameBorder').addEventListener('input',e=>updateStyle('borderColor',e.target.value));
$('photoFit').addEventListener('change',e=>{
  updateStyle('objectFit',e.target.value);
  const d=findElement(selected),node=document.querySelector(`[data-id="${selected}"] img`);
  if(d&&node)node.style.objectFit=e.target.value;
});
$('stickerChoice').addEventListener('change',e=>{
  const d=findElement(selected); if(!d||d.type!=='sticker')return;
  d.emoji=e.target.value; d.src=''; refreshSelected();
});
$('stickerSize').addEventListener('input',e=>{
  const d=findElement(selected);if(!d||d.type!=='sticker')return;
  d.w=Number(e.target.value);d.h=d.w;
  const node=document.querySelector(`[data-id="${selected}"]`);
  if(node){node.style.width=d.w+'px';node.style.height=d.h+'px';node.style.fontSize=d.w+'px';}
});

function updateStyle(key,value) {
  const d=findElement(selected); if(!d)return;
  d.style[key]=value;
  refreshSelected();
}

$('frameUpload').addEventListener('change',e=>readImage(e.target.files[0],src=>{
  const d=findElement(selected); if(!d||d.type!=='frame')return;
  snapshot();d.src=src;refreshSelected();e.target.value='';
}));
$('fileInput').addEventListener('change',e=>{
  const file=e.target.files[0]; if(!file)return;
  readImage(file,src=>{
    if(selected && findElement(selected)?.type==='frame'){
      snapshot();findElement(selected).src=src;refreshSelected();
    } else {
      const d=addElement(currentPage,'frame',{x:10,y:15,w:80,h:300,src});
      toast('Photo added to Page '+currentPage);
    }
    e.target.value='';
  });
});
$('stickerUpload').addEventListener('change',e=>readImage(e.target.files[0],src=>{
  const d=findElement(selected); if(!d||d.type!=='sticker')return;
  snapshot();d.src=src;refreshSelected();e.target.value='';
}));

function readImage(file,callback) {
  if(!file)return;
  if(!file.type.startsWith('image/'))return toast('Please choose an image file.');
  if(file.size>5*1024*1024) {
    return toast('Please choose an image smaller than 5 MB.');
  }
  const reader=new FileReader();
  reader.onload=()=>callback(reader.result);
  reader.onerror=()=>toast('Could not read that image.');
  reader.readAsDataURL(file);
}

function clearPhoto() {
  const d=findElement(selected);
  if(!d||d.type!=='frame')return;
  snapshot();d.src='';refreshSelected();toast('Photo removed.');
}
function deleteSelected() {
  if(!selected)return toast('Select an element first.');
  snapshot();
  const page=findElementPage(selected);
  pageElements[page]=pageElements[page].filter(e=>e.id!==selected);
  document.querySelectorAll(`[data-id="${selected}"]`).forEach(e=>e.remove());
  selectElement(null);toast('Element deleted.');
}
function duplicateSelected() {
  if(!selected)return toast('Select an element first.');
  const d=findElement(selected);if(!d)return;
  const copy=JSON.parse(JSON.stringify(d));
  copy.id=uid();copy.x=Math.min(90,copy.x+4);copy.y=Math.min(90,copy.y+4);
  snapshot();pageElements[findElementPage(selected)].push(copy);
  renderElement(findElementPage(selected),copy);selectElement(copy.id);
  toast('Element duplicated!');
}
function bringForward() {
  const node=document.querySelector(`[data-id="${selected}"]`);
  if(node)node.style.zIndex=(parseInt(node.style.zIndex)||10)+1;
}
function sendBackward() {
  const node=document.querySelector(`[data-id="${selected}"]`);
  if(node)node.style.zIndex=Math.max(1,(parseInt(node.style.zIndex)||10)-1);
}

function applyDetails(takeSnapshot=true) {
  if(takeSnapshot)snapshot();
  document.querySelector('[data-edit="name"]').textContent=$('nameInput').value||"Celebrant's Name";
  document.querySelector('[data-edit="date"]').textContent=$('dateInput').value||'Birthday Date & Time';
  document.querySelector('[data-edit="venue"]').textContent=$('venueInput').value||'Venue and Location';
  document.querySelector('.editable-title').textContent=$('headingInput').value||'My Magical 7th Birthday';
  document.querySelector('.thank-message').textContent=$('thanksInput').value||'Thank you for making my little world brighter! See you in my fairytale!';
  toast('Birthday details updated! 🎂');
}
function changeBackground() {
  $('bgPicker').click();
}
function setPageBackground() {
  snapshot();
  currentPageEl().style.background=`radial-gradient(ellipse at 15% 10%,#fff 0%,transparent 28%),linear-gradient(145deg,${$('bgPicker').value},#f3eaff)`;
  toast('Page background changed!');
}

function togglePreview() {
  previewMode=!previewMode;
  document.body.classList.toggle('preview',previewMode);
  if(previewMode) {
    document.querySelectorAll('.selected').forEach(n=>n.classList.remove('selected'));
    toast('Preview mode — your editing controls are hidden.');
  } else {
    toast('Back to editing mode!');
  }
}
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'&&previewMode)togglePreview();
  if((e.key==='Delete'||e.key==='Backspace')&&selected&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)&&!document.activeElement.isContentEditable)deleteSelected();
});

function makeFrame(page,x=0) {
  addElement(page,'frame',{
    x,y:18,w:90,h:300,
    style:{background:'#fff8fc',borderColor:'#ffffff',borderRadius:15,objectFit:'cover'}
  });
}
function init() {
  // Page 2 starts with one large empty portrait frame.
  makeFrame(2,0);
  // Page 3 starts with exactly four empty vertical frames.
  [0,1,2,3].forEach(i=>addElement(3,'frame',{
    x:3+i*24,y:18,w:21,h:310,
    style:{background:'#fff8fc',borderColor:'#ffffff',borderRadius:15,objectFit:'cover'}
  }));
  // Page 4 starts with exactly three empty vertical frames.
  [0,1,2].forEach(i=>addElement(4,'frame',{
    x:5+i*31,y:18,w:27,h:310,
    style:{background:'#fff8fc',borderColor:'#ffffff',borderRadius:15,objectFit:'cover'}
  }));
  // Move default elements into their dedicated galleries.
  for(let n of [2,3,4]) {
    const gallery=$('gallery'+n);
    pageElements[n].forEach(d=>{
      const node=document.querySelector(`[data-id="${d.id}"]`);
      if(node)gallery.appendChild(node);
    });
  }
  // Make the main page content editable by selecting its text.
  document.querySelectorAll('[data-edit],.editable-title,.thank-message').forEach(node=>{
    node.style.cursor='text';
    node.addEventListener('click',e=>{
      e.stopPropagation();
      const key=node.dataset.edit;
      if(key) {
        const input={name:'nameInput',date:'dateInput',venue:'venueInput'}[key];
        const val=prompt('Edit '+key, node.textContent);
        if(val!==null) { $(input).value=val;applyDetails(); }
      } else {
        const val=prompt('Edit text',node.textContent);
        if(val!==null) {
          snapshot();node.textContent=val;
          if(node.classList.contains('editable-title'))$('headingInput').value=val;
          if(node.classList.contains('thank-message'))$('thanksInput').value=val;
        }
      }
    });
  });
  $('bgPicker').addEventListener('input',()=>setPageBackground());
  loadProject();
}
init();
</script>
</body>
</html>
